    <script>
      const form = document.querySelector('form[data-fallback-email]');
      if (form) {
        const status = form.querySelector('[data-form-status]');
        const btn = form.querySelector('button[type="submit"]');
        const labelEl = form.querySelector('[data-submit-label]');
        const original = labelEl ? labelEl.textContent : 'Send request';

        const show = (msg, ok) => {
          if (!status) return;
          status.textContent = msg;
          status.style.display = 'block';
          status.style.color = ok ? '#9FD4B4' : '#F4A9A9';
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;

          const data = new FormData(form);
          const hasKey = form.dataset.hasKey === 'true';

          // No form backend configured yet — hand off to the visitor's email
          // client so an inquiry is never silently lost.
          if (!hasKey) {
            const email = form.dataset.fallbackEmail;
            const lines = [];
            data.forEach((v, k) => {
              if (['access_key', 'subject', 'from_name', 'botcheck'].includes(k)) return;
              if (typeof v === 'string' && v.trim()) {
                lines.push(k.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) + ': ' + v);
              }
            });
            const subject = String(data.get('subject') || 'Website inquiry');
            window.location.href =
              'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
            show('Opening your email app so you can send this to us directly.', true);
            return;
          }

          if (btn) btn.disabled = true;
          if (labelEl) labelEl.textContent = 'Sending…';

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: data,
            });
            if (res.ok) {
              form.reset();
              if (labelEl) labelEl.textContent = "Thank you — we'll be in touch";
              show('Thank you — your message is on its way. We usually respond within one business day.', true);
              return;
            }
            show('Something went wrong sending your message. Please call us at 786-566-5863.', false);
          } catch {
            show('We could not send your message. Please call us at 786-566-5863.', false);
          } finally {
            if (btn) btn.disabled = false;
            if (labelEl && labelEl.textContent === 'Sending…') labelEl.textContent = original;
          }
        });
      }
    </script>
