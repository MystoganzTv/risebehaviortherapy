---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { contact, services, settings, steps, insurances, founders, facts } from '../data/site';

import together from '../assets/founders-together.jpg';
import male from '../assets/founder-male.jpg';
import female from '../assets/founder-female.jpg';

const photos = { male, female };

const trust = [
  { icon: 'shield', label: 'BCBA-owned & led' },
  { icon: 'users', label: facts.agesShort },
  { icon: 'check', label: 'Insurance accepted' },
  { icon: 'pin', label: 'Center · home · school' },
];
---

<Base
  title="home"
  description="BCBA-owned ABA therapy in Miami Lakes, FL for children and young adults ages 2–20. Center-based, in-home and school-based services across Florida. Most insurance accepted — free benefits check."
>
  <!-- ══════════ HERO ══════════ -->
  <section class="relative overflow-hidden bg-navy-900">
    <div class="pointer-events-none absolute inset-0 grid-lines opacity-60 mix-blend-overlay"></div>
    <div class="pointer-events-none absolute -left-40 -top-32 h-[34rem] w-[34rem] rounded-full bg-navy-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute right-1/4 bottom-0 h-[26rem] w-[26rem] rounded-full bg-leaf-500/12 blur-3xl"></div>

    <div class="container-page relative grid items-center gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-24">
      <div>
        <p class="eyebrow !text-leaf-300" data-reveal>Applied Behavior Analysis · Miami Lakes, FL</p>

        <h1
          class="mt-6 text-[2.6rem] leading-[1.06] !text-white sm:text-5xl lg:text-[4rem] lg:leading-[1.03]"
          data-reveal
          style="--reveal-delay:70ms"
        >
          Your partner in every step of your child’s journey.
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-navy-200" data-reveal style="--reveal-delay:140ms">
          Rise Behavior Therapy delivers evidence-based ABA therapy in a supportive,
          compassionate environment where every child can thrive — designed and supervised
          by Board Certified Behavior Analysts who own the practice and stay in the field.
        </p>

        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay:210ms">
          <a href="/contact/" class="btn-accent">
            Request a free consultation<Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={contact.phoneHref} class="btn-onnavy">
            <Icon name="phone" class="h-4 w-4" />{contact.phone}
          </a>
        </div>

        <dl class="mt-12 grid max-w-xl grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4" data-reveal style="--reveal-delay:280ms">
          {trust.map((t) => (
            <div class="flex items-start gap-2.5">
              <Icon name={t.icon} class="mt-0.5 h-4.5 w-4.5 shrink-0 text-leaf-300" />
              <dt class="text-[0.87rem] font-medium leading-snug text-navy-100">{t.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative" data-reveal style="--reveal-delay:180ms">
        <div class="relative overflow-hidden rounded-[2.25rem] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.6)] ring-1 ring-white/15">
          <Image
            src={together}
            alt="The Board Certified Behavior Analysts who founded Rise Behavior Therapy, in their Miami Lakes office"
            widths={[480, 760, 1100]}
            sizes="(min-width: 1024px) 42vw, 92vw"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-navy-950/80 to-transparent"></div>
          <div class="absolute inset-x-5 bottom-5 sm:inset-x-7 sm:bottom-7">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-leaf-300">Founded & led by</p>
            <p class="mt-1.5 font-serif text-lg text-white sm:text-xl">
              {founders.map((f) => f.name).join(' & ')}
            </p>
            <p class="text-[0.85rem] text-navy-200">Board Certified Behavior Analysts</p>
          </div>
        </div>

        <div
          class="absolute -right-3 -top-5 hidden rounded-3xl bg-white p-5 shadow-lift ring-1 ring-navy-100 sm:block lg:-right-6"
        >
          <p class="font-serif text-3xl text-navy-800">100%</p>
          <p class="mt-1 max-w-[9rem] text-[0.8rem] leading-snug text-ink-600">
            of programs designed &amp; supervised by a BCBA
          </p>
        </div>
      </div>
    </div>

    <!-- insurance marquee -->
    <div class="relative border-t border-white/10">
      <div class="container-page flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:gap-10">
        <p class="shrink-0 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-navy-300">
          Insurance accepted
        </p>
        <div class="flex flex-wrap gap-x-7 gap-y-2.5">
          {insurances.slice(0, 8).map((i) => (
            <span class="text-[0.9rem] font-medium text-navy-200/90">{i}</span>
          ))}
          <a href="/insurance/" class="text-[0.9rem] font-semibold text-leaf-300 underline decoration-leaf-400/40 underline-offset-4 hover:text-leaf-200">
            + more
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ INTRO / PROMISE ══════════ -->
  <section class="container-page py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">Why families choose Rise</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
          Helping children rise to their full potential.
        </h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink-600" data-reveal style="--reveal-delay:100ms">
        <p>
          Rise was founded by two Board Certified Behavior Analysts who were tired of watching
          good clinical practice get diluted by caseload math. So they built a practice around
          the opposite premise: small caseloads, consistent staffing, and a BCBA who is genuinely
          involved in your child’s program — not a signature on a report.
        </p>
        <p>
          Every program is written for one child. Goals are chosen with families, not handed to
          them. And progress is measured continuously, so a plan that stops working gets changed
          instead of repeated.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/about/" class="btn-ghost">Meet the founders<Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/getting-started/" class="btn-ghost">How to get started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ SERVICES ══════════ -->
  <section class="relative bg-sand-100 py-20 lg:py-28">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Our services</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
          Everything your child needs, under one clinical standard.
        </h2>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <a
            href={`/services/#${s.slug}`}
            class="card-hover group flex flex-col"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-navy-800 text-white transition-colors duration-300 group-hover:bg-leaf-600">
              <Icon name={s.icon} class="h-5.5 w-5.5" />
            </span>
            <h3 class="mt-6 text-xl">{s.title}</h3>
            <p class="mt-3 flex-1 text-[0.97rem] leading-relaxed text-ink-600">{s.short}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-leaf-700">
              Learn more
              <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}

        <div class="flex flex-col justify-between rounded-3xl bg-navy-800 p-7 text-white" data-reveal style="--reveal-delay:350ms">
          <div>
            <h3 class="text-xl !text-white">Not sure where to start?</h3>
            <p class="mt-3 text-[0.97rem] leading-relaxed text-navy-200">
              Tell us about your child and we’ll tell you honestly whether ABA — and whether Rise —
              is the right fit.
            </p>
          </div>
          <a href="/contact/" class="btn-accent mt-7 w-full">Talk to a BCBA</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ SETTINGS ══════════ -->
  <section class="container-page py-20 lg:py-28">
    <div class="grid gap-4 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">Where we work</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.6rem] lg:leading-[1.12]">
          Therapy that meets your child where they are.
        </h2>
      </div>
      <p class="text-lg leading-relaxed text-ink-600 lg:pb-2" data-reveal style="--reveal-delay:80ms">
        {facts.serviceAreaLong} Skills only matter if they hold up in real life — so we teach
        them in the settings where your child actually lives, learns and plays.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {settings.map((s, i) => (
        <article
          class="group relative overflow-hidden rounded-3xl bg-navy-50/70 p-8 ring-1 ring-navy-100 transition-all duration-500 hover:bg-navy-800 hover:shadow-lift"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-navy-800 ring-1 ring-navy-100 transition-colors duration-500 group-hover:bg-leaf-500 group-hover:text-white group-hover:ring-leaf-500">
            <Icon name={s.icon} class="h-5.5 w-5.5" />
          </span>
          <p class="mt-6 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-700 transition-colors duration-500 group-hover:text-leaf-300">
            {s.short}
          </p>
          <h3 class="mt-2 text-2xl transition-colors duration-500 group-hover:!text-white">{s.title}</h3>
          <p class="mt-4 leading-relaxed text-ink-600 transition-colors duration-500 group-hover:text-navy-200">
            {s.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════ PROCESS ══════════ -->
  <section class="relative overflow-hidden bg-navy-900 py-20 text-white lg:py-28">
    <div class="pointer-events-none absolute inset-0 grid-lines opacity-50 mix-blend-overlay"></div>
    <div class="pointer-events-none absolute -right-32 top-10 h-[30rem] w-[30rem] rounded-full bg-leaf-500/12 blur-3xl"></div>

    <div class="container-page relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow !text-leaf-300">Getting started</p>
        <h2 class="mt-4 text-3xl !text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
          Four steps. No maze.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-navy-200">
          Starting ABA should not feel like paperwork. Here is exactly what happens from the
          moment you reach out.
        </p>
      </div>

      <ol class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="relative" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex items-center gap-4">
              <span class="font-serif text-4xl text-leaf-400">{s.n}</span>
              <span class="h-px flex-1 bg-gradient-to-r from-white/25 to-transparent"></span>
            </div>
            <h3 class="mt-5 text-xl !text-white">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-navy-200">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="mt-16" data-reveal>
        <a href="/getting-started/" class="btn-accent">
          See the full process<Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════ FOUNDERS ══════════ -->
  <section class="container-page py-20 lg:py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Who you’ll be working with</p>
      <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
        Owned and led by practicing BCBAs.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        Rise is not a franchise and not a private-equity roll-up. It is two Board Certified
        Behavior Analysts who are accountable for every program that leaves this practice.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {founders.map((f, i) => (
        <article class="card overflow-hidden !p-0" data-reveal style={`--reveal-delay:${i * 110}ms`}>
          <Image
            src={photos[f.photo]}
            alt={`${f.name}, ${f.credentials}`}
            widths={[420, 700, 900]}
            sizes="(min-width: 768px) 44vw, 92vw"
            class="aspect-[5/4] w-full object-cover object-top"
            loading="lazy"
          />
          <div class="p-7 lg:p-8">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-700">{f.role}</p>
            <h3 class="mt-2 text-2xl">{f.name}</h3>
            <p class="mt-1 text-sm font-medium text-ink-500">{f.credentials}</p>
            <p class="mt-5 leading-relaxed text-ink-600">{f.bio[0]}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10" data-reveal>
      <a href="/about/" class="btn-ghost">Read more about Rise<Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>

  <!-- ══════════ VALUES BAND ══════════ -->
  <section class="border-y border-navy-100 bg-sand-100 py-14">
    <div class="container-page grid gap-8 text-center sm:grid-cols-3">
      {[
        { t: 'Empowering minds.', d: 'Skills that build real independence.' },
        { t: 'Inspiring growth.', d: 'Progress you can see in the data and at home.' },
        { t: 'Transforming futures.', d: 'Outcomes that outlast the therapy hours.' },
      ].map((v, i) => (
        <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <p class="font-serif text-2xl text-navy-800">{v.t}</p>
          <p class="mt-2 text-[0.95rem] text-ink-600">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <Faq limit={5} />

  <CtaBand />
</Base>
