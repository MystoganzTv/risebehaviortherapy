---
/**
 * Rise Behavior Therapy — single-page landing.
 *
 * Faithful build of the approved design canvas
 * (design-source/rediseno.dc.html, from Rise_Behavior_Therapy_rediseno.zip).
 *
 * Corrections applied to the canvas, confirmed with the client 2026-08-27:
 *  - phone 786-322-3109 (superseded) -> 786-566-5863
 *  - team cards now carry the founders' real names
 * Subsequent updates add the two locations, FAQs, revised copy and mobile navigation.
 */
import '../styles/landing.css';
import LandingFaq from '../components/LandingFaq.astro';
import LandingServices from '../components/LandingServices.astro';
import { serviceOfferings } from '../data/service-offerings';
import LandingHeader from '../components/LandingHeader.astro';
import { site, contact, forms, locations } from '../data/site';

const phoneDisplay = '786-566-5863';
const phoneHref = contact.phoneHref;

const title = `${site.name} — ABA Therapy in Florida & Virginia`;
const description = site.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  slogan: site.tagline,
  description: site.description,
  url: site.url,
  logo: `${site.url}/logo.svg`,
  image: `${site.url}/og.jpg`,
  telephone: contact.phoneRaw,
  faxNumber: contact.fax,
  email: contact.email,
  priceRange: '$$',
  medicalSpecialty: 'Applied Behavior Analysis',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.state,
    postalCode: contact.address.zip,
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'State', name: 'Florida' },
    { '@type': 'State', name: 'Virginia' },
  ],
  location: locations.map((location) => ({
    '@type': 'Place',
    '@id': `${site.url}/#${location.id}`,
    name: `${site.name} — ${location.city}`,
    hasMap: location.address.mapsUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: location.address.street,
      addressLocality: location.address.city,
      addressRegion: location.address.state,
      postalCode: location.address.zip,
      addressCountry: 'US',
    },
  })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E2440" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />
  </head>

  <body>
    <a href="#top" class="skip-link">Skip to content</a>

    <div style="font-family:'IBM Plex Sans',system-ui,sans-serif;color:#0E2440;background:#FBF9F5;overflow-x:clip">

      <LandingHeader />

      <!-- ── Hero ────────────────────────────────────────────────── -->
      <section id="top" style="background:#0E2440;color:#FBF9F5;position:relative;overflow:hidden;isolation:isolate">
        <img
          src="/images/lobby-hero.webp"
          alt="Reception area at the Rise Behavior Therapy clinic in Miami Lakes"
          fetchpriority="high"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 38%;filter:saturate(0.95) contrast(1.02)"
        />
        <div class="hero-shade" style="position:absolute;inset:0;background:linear-gradient(96deg,rgba(9,24,43,0.96) 0%,rgba(9,24,43,0.9) 30%,rgba(9,24,43,0.62) 48%,rgba(9,24,43,0.14) 70%,rgba(9,24,43,0.1) 100%)"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,24,43,0.4) 0%,transparent 24%,rgba(9,24,43,0.25) 100%)"></div>
        <div class="hero-content" style="position:relative;max-width:1240px;margin:0 auto;padding:112px 32px 104px">
          <div style="max-width:min(600px,100%);display:flex;flex-direction:column;animation:riseUp 0.7s ease-out both">
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:30px">
              <span style="width:44px;height:1px;background:#1C7A45;display:block;flex:none"></span>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.16em;text-transform:uppercase;color:#7FC79B">Applied Behavior Analysis &nbsp;·&nbsp; Florida &amp; Virginia</span>
            </div>
            <h1 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(38px,4.9vw,68px);line-height:1.05;letter-spacing:-0.02em;margin:0 0 26px;text-wrap:balance;text-shadow:0 2px 26px rgba(9,24,43,0.55)">
              Support for your family. Progress for <em style="font-style:italic;color:#9FD4B4">everyday life</em>.
            </h1>
            <p style="font-size:20px;line-height:1.62;color:#C4D0DE;margin:0 0 38px;text-wrap:pretty;text-shadow:0 1px 16px rgba(9,24,43,0.6)">
              Finding the right support starts with being heard. We build personalized ABA programs around each
              person's strengths, needs, and daily routines. With locations in Miami Lakes, Florida, and Herndon,
              Virginia, our team helps children, adolescents, adults, and their families work toward meaningful goals.
            </p>
            <div class="hero-actions" style="display:flex;flex-wrap:wrap;gap:14px">
              <a href="#contact" class="h-green-btn" style="background:#1C7A45;color:#fff;padding:17px 32px;font-size:16.5px;font-weight:500;border-radius:2px">Schedule a Consultation</a>
              <a href={phoneHref} class="h-outline" style="border:1px solid rgba(251,249,245,0.45);color:#FBF9F5;padding:17px 32px;font-size:16.5px;font-weight:500;border-radius:2px;backdrop-filter:blur(3px)">Call {phoneDisplay}</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Stat strip ──────────────────────────────────────────── -->
      <section style="background:#0E2440;color:#FBF9F5;border-top:1px solid rgba(251,249,245,0.14)">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px">
          <div class="stat-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px 48px;padding:44px 0 48px">
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">BCBA</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Supervised treatment plans and monthly clinical review</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">1:1</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">A dedicated technician paired with every client</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">3</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Settings supported: home, clinic, and school</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">2–4</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Weeks from first call to first session, typically</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Credentials strip ───────────────────────────────────── -->
      <section style="background:#FBF9F5;border-bottom:1px solid #E6E0D6">
        <div style="max-width:1240px;margin:0 auto;padding:26px 32px;display:flex;flex-wrap:wrap;align-items:center;gap:18px 44px;justify-content:space-between">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#6F6A5D">Credentials &amp; coverage</span>
          <div style="display:flex;flex-wrap:wrap;gap:14px 34px;align-items:center;font-size:15px;color:#3A4859;font-weight:500">
            <span>Board Certified Behavior Analysts</span>
            <span style="color:#D6CFC2">/</span>
            <span>Registered Behavior Technicians</span>
            <span style="color:#D6CFC2">/</span>
            <span>Most major insurance plans</span>
            <span style="color:#D6CFC2">/</span>
            <span>Medicaid &amp; private pay</span>
          </div>
        </div>
      </section>

      <!-- ── 01 Approach ─────────────────────────────────────────── -->
      <section id="approach" style="max-width:1240px;margin:0 auto;padding:120px 32px 110px">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:56px 80px;align-items:start">
          <div class="sticky-col" style="position:sticky;top:120px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">01 — Our Approach</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0 0 24px">Your experience helps shape the plan.</h2>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0 0 20px;text-wrap:pretty">
              You know the routines, challenges, and moments that matter at home. We bring clinical expertise
              and listen to what you see every day. Together, we choose practical goals and review progress
              as needs change.
            </p>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0">
              A Board Certified Behavior Analyst designs and supervises each plan. We explain what we're
              working on, share progress with you, and practice strategies you can use in your family's routines.
            </p>
          </div>
          <div style="display:flex;flex-direction:column">
            <div class="approach-point" style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">I.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Understanding comes first</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">We start by listening and assessing current skills, strengths, and support needs. Your priorities help us turn that understanding into clear, measurable goals.</p>
              </div>
            </div>
            <div class="approach-point" style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">II.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Care that respects the person</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">We build trust, make room for individual interests, and pay attention to each person's willingness to participate. Learning connects with familiar activities at home, at school, and in the community.</p>
              </div>
            </div>
            <div class="approach-point" style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">III.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Progress we review together</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Our team records progress during sessions, and your BCBA uses that information alongside your feedback to guide care. We explain what we're seeing and adjust the plan when a different approach is needed.</p>
              </div>
            </div>
            <div class="approach-point" style="border-top:1px solid #E6E0D6;border-bottom:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">IV.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Goals that connect to everyday life</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Asking for help. Taking part in a family routine. Practicing a skill with greater independence. Goals look different for every person, and we build each plan around what is meaningful to them and their family.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── 02 Services ─────────────────────────────────────────── -->
      <LandingServices />

      <!-- ── 03 Getting started ──────────────────────────────────── -->
      <section id="process" style="max-width:1240px;margin:0 auto;padding:120px 32px">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:70px">
          <div style="max-width:620px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">03 — Getting Started with ABA</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0">From first call to first session.</h2>
          </div>
          <div style="font-size:15.5px;color:#6F6A5D;font-family:'IBM Plex Mono',monospace">Typical timeline: 2–4 weeks</div>
        </div>
        <div class="steps" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:0;border-top:1px solid #0E2440">
          <div style="padding:34px 26px 40px 0;border-right:1px solid #E6E0D6">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 01</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Consultation</h3>
            <p style="font-size:16.5px;line-height:1.6;color:#5A6472;margin:0">A short call to understand your concerns, goals, and schedule. No cost, no obligation.</p>
          </div>
          <div style="padding:34px 28px 40px;border-right:1px solid #E6E0D6">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 02</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Insurance &amp; intake</h3>
            <p style="font-size:16.5px;line-height:1.6;color:#5A6472;margin:0">We verify your benefits, confirm authorization, and collect the diagnostic documentation needed.</p>
          </div>
          <div style="padding:34px 28px 40px;border-right:1px solid #E6E0D6">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 03</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Assessment</h3>
            <p style="font-size:16.5px;line-height:1.6;color:#5A6472;margin:0">A BCBA completes the assessment and writes a treatment plan with you, target by target.</p>
          </div>
          <div style="padding:34px 0 40px 26px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 04</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Therapy begins</h3>
            <p style="font-size:16.5px;line-height:1.6;color:#5A6472;margin:0">Sessions start with your assigned technician, with ongoing BCBA supervision and progress reviews.</p>
          </div>
        </div>
      </section>

      <!-- ── 04 Team ─────────────────────────────────────────────── -->
      <section id="team" style="background:#F3EFE8;padding:110px 0;border-top:1px solid #E6E0D6;border-bottom:1px solid #E6E0D6">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px">
          <div style="max-width:620px;margin-bottom:64px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">04 — Our Team</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0 0 20px">The clinicians behind every plan.</h2>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0">Rise was founded by two clinicians who wanted families to have direct access to the person designing their child's program — not a case number in a queue.</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:32px">
            <article style="background:#FBF9F5;border:1px solid #E6E0D6">
              <div style="aspect-ratio:4/5;overflow:hidden;background:#16375E">
                <img src="/images/founder-1.webp" alt="Mauricio Marti Padron, BCBA — Co-Founder and Clinical Director of Rise Behavior Therapy" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:64% 30%" />
              </div>
              <div class="founder-bio" style="padding:32px 34px 36px">
                <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#1C7A45;margin-bottom:12px">Co-Founder &amp; Clinical Director · BCBA</div>
                <h3 style="font-family:'Newsreader',serif;font-size:30px;font-weight:400;margin:0 0 14px;letter-spacing:-0.01em">Mauricio Marti Padron</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Oversees clinical programming, supervision, and quality of care across all service lines. Leads treatment planning and BCBA training at Rise.</p>
              </div>
            </article>
            <article style="background:#FBF9F5;border:1px solid #E6E0D6">
              <div style="aspect-ratio:4/5;overflow:hidden;background:#16375E">
                <img src="/images/founder-2.webp" alt="Adamarys Valdes Martinez, BCBA — Co-Founder of Rise Behavior Therapy" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:62% 26%" />
              </div>
              <div class="founder-bio" style="padding:32px 34px 36px">
                <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#1C7A45;margin-bottom:12px">Co-Founder &amp; Director of Operations · BCBA</div>
                <h3 style="font-family:'Newsreader',serif;font-size:30px;font-weight:400;margin:0 0 14px;letter-spacing:-0.01em">Adamarys Valdes Martinez</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Leads intake, insurance authorization, and family coordination — the work that determines how quickly a family can begin therapy.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ── 05 Locations ────────────────────────────────────────── -->
      <section id="locations" aria-labelledby="locations-heading" style="max-width:1240px;margin:0 auto;padding:110px 32px">
        <div class="locations-intro">
          <div>
            <div class="location-eyebrow">05 — Our Locations</div>
            <h2 id="locations-heading">Find us in Florida and Virginia.</h2>
          </div>
          <p>Visit Rise in Miami Lakes or Herndon. Explore each location below and contact our team to arrange a visit.</p>
        </div>
        <div class="locations-grid">
          {locations.map((location) => (
            <article id={location.id} class="location-card" aria-labelledby={`${location.id}-heading`}>
              <div class="location-details">
                <div class="location-eyebrow">{location.stateName}</div>
                <h3 id={`${location.id}-heading`}>{location.city}</h3>
                <address>
                  {location.address.street}<br />
                  {location.address.city}, {location.address.state} {location.address.zip}
                </address>
                <a href={location.address.mapsUrl} target="_blank" rel="noopener noreferrer" class="location-directions" aria-label={`Open ${location.city} location in Google Maps (opens in a new tab)`}>
                  Open in Google Maps <span aria-hidden="true">↗</span>
                </a>
              </div>
              <iframe
                src={location.address.embedUrl}
                title={`Map of Rise Behavior Therapy in ${location.city}, ${location.stateName}: ${location.address.full}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                width="600"
                height="240"
              ></iframe>
            </article>
          ))}
        </div>
        <div class="clinic-overview">
          <div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">Our Miami Lakes Clinic</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(30px,3.5vw,44px);line-height:1.12;letter-spacing:-0.015em;margin:0 0 22px">A space built for focus and for play.</h2>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0 0 32px;text-wrap:pretty">Our Miami Lakes center includes individual therapy rooms, a group space for social skills, and a caregiver observation area. Families are welcome during normal business hours — come see it before you commit.</p>
            <div style="display:flex;flex-direction:column;gap:14px;border-top:1px solid #E6E0D6;padding-top:26px">
              <div style="display:flex;gap:16px;font-size:16.5px"><span style="color:#1C7A45;font-family:'IBM Plex Mono',monospace;font-size:13.5px;width:70px;flex:none;padding-top:3px">ADDRESS</span><span style="color:#3A4859">5901 NW 151st Street, Ste 206<br />Miami Lakes, FL 33014</span></div>
              <div style="display:flex;gap:16px;font-size:16.5px"><span style="color:#1C7A45;font-family:'IBM Plex Mono',monospace;font-size:13.5px;width:70px;flex:none;padding-top:3px">HOURS</span><span style="color:#3A4859">Monday – Friday, 9:00 am – 5:00 pm</span></div>
              <div style="display:flex;gap:16px;font-size:16.5px"><span style="color:#1C7A45;font-family:'IBM Plex Mono',monospace;font-size:13.5px;width:70px;flex:none;padding-top:3px">PHONE</span><a href={phoneHref} style="color:#0E2440;font-weight:500">{phoneDisplay}</a></div>
            </div>
          </div>
          <div class="clinic-grid" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:280px 176px;gap:14px;min-width:0">
            <figure style="grid-column:span 2;position:relative;min-width:0;overflow:hidden;margin:0;background:#16375E">
              <img src="/images/session.webp" alt="A therapist working one-on-one with a child" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 48%" />
            </figure>
            <figure style="position:relative;min-width:0;overflow:hidden;margin:0;background:#16375E">
              <img src="/images/playroom.webp" alt="Play and social skills room" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:52% 60%" />
            </figure>
            <figure style="position:relative;min-width:0;overflow:hidden;margin:0;background:#16375E">
              <img src="/images/therapy-room.webp" alt="Individual therapy room" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 62%" />
            </figure>
          </div>
        </div>
      </section>

      <!-- ── Careers ─────────────────────────────────────────────── -->
      <section id="careers" style="background:#16375E;color:#FBF9F5;padding:84px 0">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px;display:flex;flex-wrap:wrap;gap:32px 56px;align-items:center;justify-content:space-between">
          <div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#9FD4B4;margin-bottom:18px">Careers</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(28px,3vw,38px);line-height:1.15;margin:0 0 16px">We're hiring BCBAs and RBTs in Florida and Virginia.</h2>
            <p style="font-size:17.5px;line-height:1.65;color:#B9C6D6;max-width:62ch;margin:0">Manageable caseloads, real supervision hours, and paid administrative time. If you want to practice ABA the way it was taught to you, we'd like to talk.</p>
          </div>
          <a href="#contact" class="h-cream-btn" style="background:#FBF9F5;color:#0E2440;padding:17px 32px;font-size:16.5px;font-weight:500;border-radius:2px;white-space:nowrap">View openings</a>
        </div>
      </section>

      <LandingFaq />

      <!-- ── 07 Contact ──────────────────────────────────────────── -->
      <section id="contact" style="max-width:1240px;margin:0 auto;padding:110px 32px 120px">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,370px),1fr));gap:56px 80px;align-items:start">
          <div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">07 — Contact</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(34px,4vw,50px);line-height:1.08;letter-spacing:-0.02em;margin:0 0 24px">You don't need to have every answer to reach out.</h2>
            <p style="font-size:19px;line-height:1.66;color:#5A6472;margin:0 0 20px;max-width:46ch;text-wrap:pretty">Whether you're exploring therapy, looking for family support, or seeking professional guidance, we can talk through your questions, explain the next steps, and help you understand whether Rise is a good fit.</p>
            <p style="font-size:17px;line-height:1.66;color:#5A6472;margin:0 0 40px;max-width:46ch">Send us a message or call our team to start the conversation.</p>
            <a href={phoneHref} class="h-call" style="display:inline-flex;align-items:baseline;gap:14px;border-top:1px solid #0E2440;border-bottom:1px solid #E6E0D6;padding:22px 0;width:100%;color:#0E2440">
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.16em;color:#6F6A5D">CALL</span>
              <span style="font-family:'Newsreader',serif;font-size:clamp(28px,3.2vw,40px);line-height:1;letter-spacing:-0.01em">{phoneDisplay}</span>
            </a>
            <div style="margin-top:44px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:32px 40px">
              <div>
                <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;color:#6F6A5D;margin-bottom:10px">VISIT</div>
                {locations.map((location) => (
                  <address class="contact-location">
                    <a href={`#${location.id}`}>{location.city}, {location.stateName}</a>
                    <span>{location.address.street}<br />{location.address.city}, {location.address.state} {location.address.zip}</span>
                  </address>
                ))}
              </div>
              <div>
                <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;color:#6F6A5D;margin-bottom:10px">HOURS</div>
                <div style="font-size:17px;line-height:1.6;color:#3A4859">Mon – Fri &nbsp;9:00 – 17:00<br />Sat – Sun &nbsp;Closed</div>
              </div>
            </div>
          </div>

          <form
            id="lead-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-fallback-email={contact.email}
            data-has-key={forms.accessKey ? 'true' : 'false'}
            style="background:#0E2440;padding:44px 44px 48px;color:#FBF9F5;min-width:0"
          >
            <input type="hidden" name="access_key" value={forms.accessKey} />
            <input type="hidden" name="subject" value="New consultation request — risebehaviortherapy.com" />
            <input type="hidden" name="from_name" value="Rise Behavior Therapy website" />
            <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true" />

            <h3 style="font-family:'Newsreader',serif;font-size:26px;font-weight:400;margin:0 0 8px">Let's start with a conversation.</h3>
            <p style="font-size:15.5px;line-height:1.6;color:#93A3B6;margin:0 0 32px">Tell us what you're looking for or ask a question. Fields marked with * are required.</p>
            <div style="display:flex;flex-direction:column;gap:22px">
              <label style="display:flex;flex-direction:column;gap:8px;min-width:0">
                <span style="font-size:13.5px;letter-spacing:0.1em;text-transform:uppercase;color:#9FB0C4">Full name *</span>
                <input class="f-underline" name="name" required type="text" autocomplete="name" style="background:transparent;border:0;border-bottom:1px solid rgba(251,249,245,0.28);color:#FBF9F5;font-family:inherit;font-size:17.5px;padding:8px 0;outline:none;width:100%;min-width:0" />
              </label>
              <div class="two-up" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;min-width:0">
                <label style="display:flex;flex-direction:column;gap:8px;min-width:0">
                  <span style="font-size:13.5px;letter-spacing:0.1em;text-transform:uppercase;color:#9FB0C4">Email *</span>
                  <input class="f-underline" name="email" required type="email" autocomplete="email" style="background:transparent;border:0;border-bottom:1px solid rgba(251,249,245,0.28);color:#FBF9F5;font-family:inherit;font-size:17.5px;padding:8px 0;outline:none;width:100%;min-width:0" />
                </label>
                <label style="display:flex;flex-direction:column;gap:8px;min-width:0">
                  <span style="font-size:13.5px;letter-spacing:0.1em;text-transform:uppercase;color:#9FB0C4">Phone</span>
                  <input class="f-underline" name="phone" type="tel" autocomplete="tel" style="background:transparent;border:0;border-bottom:1px solid rgba(251,249,245,0.28);color:#FBF9F5;font-family:inherit;font-size:17.5px;padding:8px 0;outline:none;width:100%;min-width:0" />
                </label>
              </div>
              <label style="display:flex;flex-direction:column;gap:8px;min-width:0">
                <span style="font-size:13.5px;letter-spacing:0.1em;text-transform:uppercase;color:#9FB0C4">I'm reaching out about</span>
                <select class="f-underline" name="topic" style="background:transparent;border:0;border-bottom:1px solid rgba(251,249,245,0.28);color:#FBF9F5;font-family:inherit;font-size:17.5px;padding:8px 0;outline:none;width:100%;min-width:0">
                  {serviceOfferings.map((service) => (
                    <option value={service.title} style="color:#0E2440">{service.title}</option>
                  ))}
                  <option style="color:#0E2440">Services for an adolescent or adult</option>
                  <option style="color:#0E2440">An assessment or diagnosis</option>
                  <option style="color:#0E2440">A professional referral</option>
                  <option style="color:#0E2440">Insurance verification</option>
                  <option style="color:#0E2440">Employment at Rise</option>
                </select>
              </label>
              <label style="display:flex;flex-direction:column;gap:8px;min-width:0">
                <span style="font-size:13.5px;letter-spacing:0.1em;text-transform:uppercase;color:#9FB0C4">How can we help?</span>
                <textarea class="f-underline" name="message" rows="3" style="background:transparent;border:0;border-bottom:1px solid rgba(251,249,245,0.28);color:#FBF9F5;font-family:inherit;font-size:17.5px;padding:8px 0;outline:none;resize:vertical;width:100%;min-width:0"></textarea>
              </label>
            </div>
            <button type="submit" class="h-green-btn" style="margin-top:34px;width:100%;background:#1C7A45;color:#fff;border:0;padding:17px;font-family:inherit;font-size:16.5px;font-weight:500;cursor:pointer;border-radius:2px">
              <span data-submit-label>Send request</span>
            </button>
            <p data-form-status role="status" aria-live="polite" style="display:none;font-size:15px;line-height:1.6;margin:18px 0 0"></p>
            <p style="font-size:13.5px;line-height:1.6;color:#7E8FA3;margin:20px 0 0">Submitting this form does not establish a clinical relationship. For emergencies, call 911.</p>
          </form>
        </div>
      </section>

      <!-- ── Footer ──────────────────────────────────────────────── -->
      <footer style="background:#0A1A2F;color:#8FA0B4;padding:64px 0 32px">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:40px 48px;padding-bottom:48px;border-bottom:1px solid rgba(251,249,245,0.12)">
            <div>
              <div style="display:flex;flex-direction:column;gap:4px;margin-bottom:18px">
                <span style="font-family:'Newsreader',serif;font-size:24px;letter-spacing:0.34em;color:#FBF9F5;line-height:1">RISE</span>
                <span style="font-size:10px;letter-spacing:0.24em;color:#7FC79B;font-weight:600;text-transform:uppercase">Behavior Therapy</span>
              </div>
              <p style="font-size:16px;line-height:1.6;margin:0;max-width:32ch">Building potential. Inspiring futures. Applied behavior analysis in Florida and Virginia.</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;font-size:16px">
              <span style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7E8FA6;font-family:'IBM Plex Mono',monospace">Services</span>
              {serviceOfferings.map((service) => (
                <a href={`#${service.slug}`} style="color:#8FA0B4">{service.title}</a>
              ))}
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;font-size:16px">
              <span style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7E8FA6;font-family:'IBM Plex Mono',monospace">Practice</span>
              <a href="#approach" style="color:#8FA0B4">Our approach</a>
              <a href="#team" style="color:#8FA0B4">Our team</a>
              <a href="#locations" style="color:#8FA0B4">Our locations</a>
              <a href="#faq" style="color:#8FA0B4">Frequently asked questions</a>
              <a href="#process" style="color:#8FA0B4">Getting started</a>
              <a href="#careers" style="color:#8FA0B4">Careers</a>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;font-size:16px">
              <span style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7E8FA6;font-family:'IBM Plex Mono',monospace">Contact</span>
              <a href={phoneHref} style="color:#FBF9F5">{phoneDisplay}</a>
              {locations.map((location) => (
                <a href={location.address.mapsUrl} target="_blank" rel="noopener noreferrer" style="color:#8FA0B4;line-height:1.6">
                  <strong style="color:#FBF9F5;font-weight:500">{location.city}, {location.stateName}</strong><br />
                  {location.address.street}<br />{location.address.city}, {location.address.state} {location.address.zip}
                </a>
              ))}
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;padding-top:28px;font-size:13.5px;color:#7E8FA6">
            <span>© 2026 Rise Behavior Therapy. All rights reserved.</span>
            <span>Privacy Policy · Notice of Privacy Practices (HIPAA)</span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const form = document.querySelector('form[data-fallback-email]');
      if (form) {
        const status = form.querySelector('[data-form-status]');
        const btn = form.querySelector('button[type="submit"]');
        const labelEl = form.querySelector('[data-submit-label]');
        const original = labelEl ? labelEl.textContent : 'Send request';

        const show = (msg, ok) => {
          if (!status) return;
          status.textContent = msg;
          status.style.display = 'block';
          status.style.color = ok ? '#9FD4B4' : '#F4A9A9';
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;

          const data = new FormData(form);
          const hasKey = form.dataset.hasKey === 'true';

          // No form backend configured yet — hand off to the visitor's email
          // client so an inquiry is never silently lost.
          if (!hasKey) {
            const email = form.dataset.fallbackEmail;
            const lines = [];
            data.forEach((v, k) => {
              if (['access_key', 'subject', 'from_name', 'botcheck'].includes(k)) return;
              if (typeof v === 'string' && v.trim()) {
                lines.push(k.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) + ': ' + v);
              }
            });
            const subject = String(data.get('subject') || 'Website inquiry');
            window.location.href =
              'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
            show('Opening your email app so you can send this to us directly.', true);
            return;
          }

          if (btn) btn.disabled = true;
          if (labelEl) labelEl.textContent = 'Sending…';

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: data,
            });
            if (res.ok) {
              form.reset();
              if (labelEl) labelEl.textContent = "Thank you — we'll be in touch";
              show('Thank you — your message is on its way. We usually respond within one business day.', true);
              return;
            }
            show('Something went wrong sending your message. Please call us at 786-566-5863.', false);
          } catch {
            show('We could not send your message. Please call us at 786-566-5863.', false);
          } finally {
            if (btn) btn.disabled = false;
            if (labelEl && labelEl.textContent === 'Sending…') labelEl.textContent = original;
          }
        });
      }
    </script>
  </body>
</html>
