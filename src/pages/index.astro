---
/**
 * Rise Behavior Therapy — single-page landing.
 *
 * Faithful build of the approved design canvas
 * (design-source/rediseno.dc.html, from Rise_Behavior_Therapy_rediseno.zip).
 *
 * Corrections applied to the canvas, confirmed with the client 2026-08-27:
 *  - phone 786-322-3109 (superseded) -> 786-566-5863
 *  - team cards now carry the founders' real names
 * Everything else is transcribed as designed.
 */
import '../styles/landing.css';
import { site, contact, forms } from '../data/site';

const phoneDisplay = '786-566-5863';
const phoneHref = contact.phoneHref;

const title = `${site.name} — ABA Therapy in Miami Lakes, FL`;
const description = site.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  slogan: site.tagline,
  description: site.description,
  url: site.url,
  logo: `${site.url}/logo.svg`,
  image: `${site.url}/og.jpg`,
  telephone: contact.phoneRaw,
  faxNumber: contact.fax,
  email: contact.email,
  priceRange: '$$',
  medicalSpecialty: 'Applied Behavior Analysis',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.state,
    postalCode: contact.address.zip,
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'State', name: 'Florida' },
    { '@type': 'State', name: 'Virginia' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E2440" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />
  </head>

  <body>
    <a href="#top" class="skip-link">Skip to content</a>

    <div style="font-family:'IBM Plex Sans',system-ui,sans-serif;color:#0E2440;background:#FBF9F5;overflow-x:clip">

      <!-- ── Utility bar ─────────────────────────────────────────── -->
      <div style="background:#0E2440;color:#C6D2E0;font-size:14.5px;letter-spacing:0.04em">
        <div style="max-width:1240px;margin:0 auto;padding:10px 32px;display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between">
          <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap">
            <span>Miami Lakes, Florida</span>
            <span style="opacity:0.35">·</span>
            <span>Mon–Fri, 9:00 am – 5:00 pm</span>
          </div>
          <div style="display:flex;gap:20px;align-items:center">
            <span style="color:#7FC79B">Now accepting new clients</span>
            <a href={phoneHref} style="color:#FBF9F5;font-weight:500;letter-spacing:0.02em">{phoneDisplay}</a>
          </div>
        </div>
      </div>

      <!-- ── Header ──────────────────────────────────────────────── -->
      <header style="position:sticky;top:0;z-index:50;background:rgba(251,249,245,0.92);backdrop-filter:blur(12px);border-bottom:1px solid #E6E0D6">
        <div style="max-width:1240px;margin:0 auto;padding:18px 32px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px 28px">
          <a href="#top" style="display:flex;flex-direction:column;gap:3px;color:#0E2440;flex:none;width:max-content;white-space:nowrap">
            <span style="font-family:'Newsreader',serif;font-size:26px;letter-spacing:0.34em;font-weight:400;line-height:1">RISE</span>
            <span style="font-size:10px;letter-spacing:0.24em;color:#1C7A45;font-weight:600;text-transform:uppercase;white-space:nowrap">Behavior Therapy</span>
          </a>
          <nav style="display:flex;flex-wrap:wrap;align-items:center;gap:10px 26px;font-size:15.5px;font-weight:500;flex:1 1 auto;justify-content:center">
            <a href="#approach" style="color:#3A4859">Our Approach</a>
            <a href="#services" style="color:#3A4859">Services</a>
            <a href="#process" style="color:#3A4859">Getting Started</a>
            <a href="#team" style="color:#3A4859">Our Team</a>
            <a href="#careers" style="color:#3A4859">Careers</a>
          </nav>
          <a
            href="#contact"
            class="h-navy-cta"
            style="background:#0E2440;color:#FBF9F5;padding:13px 24px;font-size:15.5px;font-weight:500;border-radius:2px;white-space:nowrap"
            >Schedule a Consultation</a
          >
        </div>
      </header>

      <!-- ── Hero ────────────────────────────────────────────────── -->
      <section id="top" style="background:#0E2440;color:#FBF9F5;position:relative;overflow:hidden;isolation:isolate">
        <img
          src="/images/lobby-hero.webp"
          alt="Reception area at the Rise Behavior Therapy clinic in Miami Lakes"
          fetchpriority="high"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 38%;filter:saturate(0.95) contrast(1.02)"
        />
        <div style="position:absolute;inset:0;background:linear-gradient(96deg,rgba(9,24,43,0.96) 0%,rgba(9,24,43,0.9) 30%,rgba(9,24,43,0.62) 48%,rgba(9,24,43,0.14) 70%,rgba(9,24,43,0.1) 100%)"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,24,43,0.4) 0%,transparent 24%,rgba(9,24,43,0.25) 100%)"></div>
        <div style="position:relative;max-width:1240px;margin:0 auto;padding:112px 32px 104px">
          <div style="max-width:min(600px,100%);display:flex;flex-direction:column;animation:riseUp 0.7s ease-out both">
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:30px">
              <span style="width:44px;height:1px;background:#1C7A45;display:block;flex:none"></span>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.16em;text-transform:uppercase;color:#7FC79B">Applied Behavior Analysis &nbsp;·&nbsp; Miami Lakes, FL</span>
            </div>
            <h1 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(38px,4.9vw,68px);line-height:1.05;letter-spacing:-0.02em;margin:0 0 26px;text-wrap:balance;text-shadow:0 2px 26px rgba(9,24,43,0.55)">
              Evidence-based care, measured in <em style="font-style:italic;color:#9FD4B4">real progress</em>.
            </h1>
            <p style="font-size:20px;line-height:1.62;color:#C4D0DE;margin:0 0 38px;text-wrap:pretty;text-shadow:0 1px 16px rgba(9,24,43,0.6)">
              Rise Behavior Therapy delivers individualized ABA programs for children, adolescents, and adults
              across Florida and Virginia. Every plan is written, supervised, and measured by a Board Certified Behavior
              Analyst.
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:14px">
              <a href="#contact" class="h-green-btn" style="background:#1C7A45;color:#fff;padding:17px 32px;font-size:16.5px;font-weight:500;border-radius:2px">Schedule a Consultation</a>
              <a href={phoneHref} class="h-outline" style="border:1px solid rgba(251,249,245,0.45);color:#FBF9F5;padding:17px 32px;font-size:16.5px;font-weight:500;border-radius:2px;backdrop-filter:blur(3px)">Call {phoneDisplay}</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Stat strip ──────────────────────────────────────────── -->
      <section style="background:#0E2440;color:#FBF9F5;border-top:1px solid rgba(251,249,245,0.14)">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px 48px;padding:44px 0 48px">
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">BCBA</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Supervised treatment plans and monthly clinical review</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">1:1</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">A dedicated technician paired with every client</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">3</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Settings supported: home, clinic, and school</div>
            </div>
            <div>
              <div style="font-family:'Newsreader',serif;font-size:30px;line-height:1;margin-bottom:8px">2–4</div>
              <div style="font-size:14.5px;color:#93A3B6;line-height:1.55">Weeks from first call to first session, typically</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Credentials strip ───────────────────────────────────── -->
      <section style="background:#FBF9F5;border-bottom:1px solid #E6E0D6">
        <div style="max-width:1240px;margin:0 auto;padding:26px 32px;display:flex;flex-wrap:wrap;align-items:center;gap:18px 44px;justify-content:space-between">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#6F6A5D">Credentials &amp; coverage</span>
          <div style="display:flex;flex-wrap:wrap;gap:14px 34px;align-items:center;font-size:15px;color:#3A4859;font-weight:500">
            <span>Board Certified Behavior Analysts</span>
            <span style="color:#D6CFC2">/</span>
            <span>Registered Behavior Technicians</span>
            <span style="color:#D6CFC2">/</span>
            <span>Most major insurance plans</span>
            <span style="color:#D6CFC2">/</span>
            <span>Medicaid &amp; private pay</span>
          </div>
        </div>
      </section>

      <!-- ── 01 Approach ─────────────────────────────────────────── -->
      <section id="approach" style="max-width:1240px;margin:0 auto;padding:120px 32px 110px">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:56px 80px;align-items:start">
          <div class="sticky-col" style="position:sticky;top:120px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">01 — Our Approach</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0 0 24px">Personalized care, held to a clinical standard.</h2>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0 0 20px;text-wrap:pretty">
              Our philosophy is centered on individualized care that addresses the unique needs of every client.
              We take a holistic view — physical, emotional, and behavioral wellbeing considered together — and
              translate it into a treatment plan with defined targets and observable outcomes.
            </p>
            <p style="font-size:18.5px;line-height:1.68;color:#5A6472;margin:0">
              Families are part of the clinical team. You receive the same data we do, and you learn the same
              strategies your child's technician uses.
            </p>
          </div>
          <div style="display:flex;flex-direction:column">
            <div style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">I.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Assessment before intervention</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">We begin with a functional behavior assessment and skills baseline. No goal enters a treatment plan without a measurable starting point.</p>
              </div>
            </div>
            <div style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">II.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Naturalistic, dignity-first teaching</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Skills are taught where they are used — at the table, in the classroom, at the grocery store. We build on motivation and assent rather than compliance.</p>
              </div>
            </div>
            <div style="border-top:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">III.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Data reviewed every session</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">Technicians record data continuously; a BCBA reviews trends and adjusts programming. If a target isn't moving, the intervention changes — not the expectation.</p>
              </div>
            </div>
            <div style="border-top:1px solid #E6E0D6;border-bottom:1px solid #E6E0D6;padding:32px 0;display:grid;grid-template-columns:64px 1fr;gap:24px">
              <div style="font-family:'Newsreader',serif;font-size:22px;color:#1C7A45">IV.</div>
              <div>
                <h3 style="font-size:21px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em">Generalization is the goal</h3>
                <p style="font-size:17px;line-height:1.65;color:#5A6472;margin:0">A skill counts when it holds across people, places, and time. We plan for fading support from the first session, and we discharge when independence is real.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── 02 Services ─────────────────────────────────────────── -->
      <section id="services" style="background:#0E2440;color:#FBF9F5;padding:110px 0">
        <div style="max-width:1240px;margin:0 auto;padding:0 32px">
          <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:64px">
            <div style="max-width:640px">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#7FC79B;margin-bottom:22px">02 — Services</div>
              <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0">Comprehensive services under one clinical team.</h2>
            </div>
            <p style="font-size:17.5px;line-height:1.65;color:#93A3B6;max-width:34ch;margin:0">Coordinated care means one set of goals, one data system, and one point of contact for your family.</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:1px;background:rgba(251,249,245,0.14)">
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">IN HOME</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Home-Based ABA</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Therapy in the environment where most daily routines happen, with caregivers involved directly.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">IN CLINIC</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Center-Based ABA</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Structured sessions in our Miami Lakes clinic, with peer groups for social skill building.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">IN SCHOOL</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">School Support</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Classroom shadowing and consultation with teachers and IEP teams to keep goals aligned.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">DIAGNOSTIC</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Assessments</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Functional behavior assessments and skills evaluations that establish the baseline for care.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">CAREGIVERS</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Parent Training</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Structured coaching so the strategies that work in session also work on a Tuesday night.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">COMMUNICATION</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Speech Therapy</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Language, articulation, and AAC support, coordinated with behavioral programming.</p>
            </div>
            <div class="h-svc" style="background:#0E2440;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7FC79B;margin-bottom:auto;letter-spacing:0.12em">DAILY LIVING</div>
              <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 12px;line-height:1.15">Occupational Therapy</h3>
              <p style="font-size:16px;line-height:1.6;color:#A9B8CA;margin:0">Motor skills, sensory regulation, and independence in self-care routines.</p>
            </div>
            <div class="h-svc-green" style="background:#1C7A45;padding:38px 30px 44px;min-height:250px;display:flex;flex-direction:column;justify-content:space-between">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#CBEBD8;letter-spacing:0.12em">NOT SURE WHERE TO START?</div>
              <div>
                <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;margin:26px 0 14px;line-height:1.15">Talk to a BCBA</h3>
                <a href="#contact" style="font-size:16px;color:#fff;border-bottom:1px solid rgba(255,255,255,0.5);padding-bottom:3px">Request a consultation</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── 03 Getting started ──────────────────────────────────── -->
      <section id="process" style="max-width:1240px;margin:0 auto;padding:120px 32px">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:70px">
          <div style="max-width:620px">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;text-transform:uppercase;color:#1C7A45;margin-bottom:22px">03 — Getting Started</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:300;font-size:clamp(31px,3.7vw,46px);line-height:1.12;letter-spacing:-0.015em;margin:0">From first call to first session.</h2>
          </div>
          <div style="font-size:15.5px;color:#6F6A5D;font-family:'IBM Plex Mono',monospace">Typical timeline: 2–4 weeks</div>
        </div>
        <div class="steps" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:0;border-top:1px solid #0E2440">
          <div style="padding:34px 26px 40px 0;border-right:1px solid #E6E0D6">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 01</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Consultation</h3>
            <p style="font-size:16.5px;line-height:1.6;color:#5A6472;margin:0">A short call to understand your concerns, goals, and schedule. No cost, no obligation.</p>
          </div>
          <div style="padding:34px 28px 40px;border-right:1px solid #E6E0D6">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#1C7A45;margin-bottom:20px">STEP 02</div>
            <h3 style="font-size:22px;font-weight:600;margin:0 0 12px;letter-spacing:-0.01em">Insurance &amp; intake</h3>
