---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { contact, facts } from '../data/site';
---

<Base
  title="Contact Us"
  description="Contact Rise Behavior Therapy in Miami Lakes, FL. Call (786) 566-5863 or request a free consultation and insurance benefits check."
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your child."
    lead="Call us, email us, or send the form and we will call you back — usually the same business day. There is no cost and no obligation."
  />

  <section class="container-page py-16 lg:py-24">
    <div class="grid min-w-0 gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- details -->
      <div class="min-w-0 space-y-4" data-reveal>
        <a
          href={contact.phoneHref}
          class="group flex items-start gap-4 rounded-3xl bg-navy-800 p-6 text-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lift"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/20">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <span>
            <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-300">Call us</span>
            <span class="mt-1 block font-serif text-2xl">{contact.phone}</span>
            <span class="mt-1 block text-sm text-navy-200">Fastest way to reach a person</span>
          </span>
        </a>

        <a href={contact.emailHref} class="card-hover group flex items-start gap-4 !p-6">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-800 ring-1 ring-navy-100">
            <Icon name="mail" class="h-5 w-5" />
          </span>
          <span>
            <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-700">Email</span>
            <span class="mt-1 block break-all text-lg font-semibold text-navy-800">{contact.email}</span>
          </span>
        </a>

        <a href={contact.address.mapsUrl} target="_blank" rel="noopener" class="card-hover group flex items-start gap-4 !p-6">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-800 ring-1 ring-navy-100">
            <Icon name="pin" class="h-5 w-5" />
          </span>
          <span>
            <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-700">Visit our center</span>
            <span class="mt-1 block text-lg font-semibold text-navy-800">{contact.address.street}</span>
            <span class="block text-ink-600">{contact.address.city}, {contact.address.state} {contact.address.zip}</span>
          </span>
        </a>

        <div class="card !p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-800 ring-1 ring-navy-100">
              <Icon name="clock" class="h-5 w-5" />
            </span>
            <div>
              <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-700">Hours</span>
              <dl class="mt-2 space-y-2 text-[0.97rem]">
                {contact.hours.map((h) => (
                  <div class="flex flex-col gap-x-6 sm:flex-row sm:justify-between">
                    <dt class="text-ink-600">{h.days}</dt>
                    <dd class="font-semibold text-navy-800">{h.time}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-4 border-t border-navy-100 pt-3 text-sm text-ink-500">
                Fax: {contact.fax}
              </p>
            </div>
          </div>
        </div>

        <p class="rounded-3xl bg-leaf-50 px-6 py-5 text-[0.92rem] leading-relaxed text-leaf-900 ring-1 ring-leaf-100">
          Serving children and young adults {facts.ages} across {facts.serviceArea} — in our
          Miami Lakes center, at home, and in schools.
        </p>
      </div>

      <!-- form -->
      <div class="rounded-[2rem] bg-navy-50/60 p-6 ring-1 ring-navy-100 sm:p-9 lg:p-10" data-reveal style="--reveal-delay:100ms">
        <p class="eyebrow">Request a free consultation</p>
        <h2 class="mt-3 text-2xl sm:text-3xl">Tell us a little about your family.</h2>
        <p class="mt-3 leading-relaxed text-ink-600">
          We will call you back to answer questions and, if you would like, verify your insurance
          benefits at no cost.
        </p>
        <div class="mt-8">
          <LeadForm id="contact-form" />
        </div>
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="border-t border-navy-100">
    <iframe
      src={contact.address.embedUrl}
      title="Map to Rise Behavior Therapy, 5901 NW 151st Street Suite 206, Miami Lakes, FL 33014"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-[24rem] w-full border-0 lg:h-[30rem]"></iframe>
  </section>
</Base>
