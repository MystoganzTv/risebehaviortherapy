---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { jobs, contact } from '../data/site';

const perks = [
  {
    icon: 'users',
    title: 'Caseloads you can actually serve',
    body: 'We cap caseloads on purpose. You will have time to write good programs, train your team, and be present for the families on your list.',
  },
  {
    icon: 'shield',
    title: 'Supervision that shows up',
    body: 'Our BCBAs are still in the field. Support is not a monthly email — it is someone who has been in the room with your client.',
  },
  {
    icon: 'spark',
    title: 'A real growth path',
    body: 'RBT to BCaBA to BCBA. We pay for training, provide supervision hours where appropriate, and promote from within first.',
  },
  {
    icon: 'heart',
    title: 'Ethics over utilization',
    body: 'You will never be asked to bill hours that do not serve the client. Assent-based, dignity-first practice is the standard here.',
  },
];
---

<Base
  title="Careers"
  description="Join Rise Behavior Therapy — BCBA, BCaBA and RBT positions in Miami Lakes and across Florida. Manageable caseloads, real supervision, and a growth path."
>
  <PageHero
    eyebrow="Careers at Rise"
    title="Do the work you got into this field to do."
    lead="We are always looking for BCBAs, BCaBAs and RBTs who care about clinical quality more than billable targets. If that is you, we would like to talk."
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#apply" class="btn-accent">Apply now<Icon name="arrow" class="h-4 w-4" /></a>
      <a href={contact.emailHref} class="btn-onnavy"><Icon name="mail" class="h-4 w-4" />Send your résumé</a>
    </div>
  </PageHero>

  <!-- WHY -->
  <section class="container-page py-20 lg:py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Why Rise</p>
      <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.6rem] lg:leading-[1.12]">
        Owned by clinicians. It changes everything.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        Rise is not backed by private equity and not run from a distant corporate office. The people
        setting the standards are the people supervising the cases.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {perks.map((p, i) => (
        <div class="card flex gap-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-leaf-50 text-leaf-700 ring-1 ring-leaf-100">
            <Icon name={p.icon} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-2.5 leading-relaxed text-ink-600">{p.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- OPENINGS -->
  <section class="bg-sand-100 py-20 lg:py-24">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Open positions</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.6rem] lg:leading-[1.12]">
          We are hiring — continuously.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Good clinicians are hard to find, so we keep these roles open year-round. Even if the fit
          is not immediate, we would rather know you exist.
        </p>
      </div>

      <div class="mt-12 space-y-4">
        {jobs.map((j, i) => (
          <article
            class="group flex flex-col gap-6 rounded-3xl bg-white p-7 shadow-soft ring-1 ring-navy-100/80 transition-all duration-400 hover:shadow-lift sm:flex-row sm:items-center sm:justify-between sm:p-8"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="max-w-2xl">
              <h3 class="text-2xl">{j.title}</h3>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm font-medium text-ink-500">
                <span class="inline-flex items-center gap-1.5"><Icon name="clock" class="h-4 w-4 text-leaf-600" />{j.type}</span>
                <span class="inline-flex items-center gap-1.5"><Icon name="pin" class="h-4 w-4 text-leaf-600" />{j.location}</span>
              </div>
              <p class="mt-4 leading-relaxed text-ink-600">{j.blurb}</p>
            </div>
            <a href="#apply" class="btn-primary shrink-0">
              Apply<Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLY -->
  <section id="apply" class="scroll-mt-32 py-20 lg:py-28">
    <div class="container-page grid min-w-0 gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">Apply</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.5rem] lg:leading-[1.14]">
          Tell us about yourself.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          No long portal, no ten-page application. Send the basics and a BCBA will get back to you.
        </p>
        <div class="mt-8 space-y-4">
          <a href={contact.emailHref} class="flex items-center gap-3.5 break-all font-medium text-ink-700 transition hover:text-navy-800">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-800 ring-1 ring-navy-100">
              <Icon name="mail" class="h-4.5 w-4.5" />
            </span>
            {contact.email}
          </a>
          <a href={contact.phoneHref} class="flex items-center gap-3.5 font-medium text-ink-700 transition hover:text-navy-800">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-navy-50 text-navy-800 ring-1 ring-navy-100">
              <Icon name="phone" class="h-4.5 w-4.5" />
            </span>
            {contact.phone}
          </a>
        </div>
      </div>
      <div class="rounded-[2rem] bg-navy-50/60 p-6 ring-1 ring-navy-100 sm:p-9" data-reveal style="--reveal-delay:100ms">
        <LeadForm variant="career" id="career-form" />
      </div>
    </div>
  </section>
</Base>
