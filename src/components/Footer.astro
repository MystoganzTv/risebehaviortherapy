---
import { site, contact, nav, services } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const hasSocial = Object.values(contact.social).some(Boolean);
---

<footer class="relative overflow-hidden bg-navy-900 text-navy-100">
  <div class="pointer-events-none absolute inset-0 grid-lines opacity-[0.55] mix-blend-overlay"></div>
  <div
    class="pointer-events-none absolute -top-40 right-0 h-96 w-96 rounded-full bg-leaf-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr_1fr_1.3fr]">
      <div>
        <img src="/logo-h-white.svg" alt="Rise Behavior Therapy" class="h-12 w-auto sm:h-14" width="230" height="56" />
        <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-navy-200">
          BCBA-owned and BCBA-led ABA therapy for children and young adults ages 2–20 —
          delivered in our Miami Lakes center, at home, and in school across Florida.
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          <a href="/contact/" class="btn-accent !px-5 !py-3 !text-sm">Free Consultation</a>
          <a href={contact.phoneHref} class="btn-onnavy !px-5 !py-3 !text-sm">
            <Icon name="phone" class="h-4 w-4" />Call us
          </a>
        </div>
      </div>

      <nav aria-label="Footer">
        <h3 class="font-sans text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-300">Explore</h3>
        <ul class="mt-5 space-y-3 text-[0.95rem]">
          <li><a href="/" class="text-navy-200 transition hover:text-white">Home</a></li>
          {nav.map((i) => (
            <li><a href={i.href} class="text-navy-200 transition hover:text-white">{i.label}</a></li>
          ))}
          <li><a href="/contact/" class="text-navy-200 transition hover:text-white">Contact</a></li>
        </ul>
      </nav>

      <nav aria-label="Services">
        <h3 class="font-sans text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-300">Services</h3>
        <ul class="mt-5 space-y-3 text-[0.95rem]">
          {services.map((s) => (
            <li>
              <a href={`/services/#${s.slug}`} class="text-navy-200 transition hover:text-white">{s.title}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="font-sans text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-leaf-300">Get in touch</h3>
        <ul class="mt-5 space-y-4 text-[0.95rem]">
          <li>
            <a href={contact.address.mapsUrl} target="_blank" rel="noopener" class="flex gap-3 text-navy-200 transition hover:text-white">
              <Icon name="pin" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-leaf-300" />
              <span>{contact.address.street}<br />{contact.address.city}, {contact.address.state} {contact.address.zip}</span>
            </a>
          </li>
          <li>
            <a href={contact.phoneHref} class="flex items-center gap-3 text-navy-200 transition hover:text-white">
              <Icon name="phone" class="h-4.5 w-4.5 shrink-0 text-leaf-300" />{contact.phone}
            </a>
          </li>
          <li>
            <span class="flex items-center gap-3 text-navy-200">
              <Icon name="fax" class="h-4.5 w-4.5 shrink-0 text-leaf-300" />Fax {contact.fax}
            </span>
          </li>
          <li>
            <a href={contact.emailHref} class="flex items-center gap-3 break-all text-navy-200 transition hover:text-white">
              <Icon name="mail" class="h-4.5 w-4.5 shrink-0 text-leaf-300" />{contact.email}
            </a>
          </li>
          <li class="flex gap-3 text-navy-200">
            <Icon name="clock" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-leaf-300" />
            <span>
              {contact.hours.map((h) => (<span class="block">{h.days}: {h.time}</span>))}
            </span>
          </li>
        </ul>
        {hasSocial && (
          <div class="mt-6 flex gap-3">
            {contact.social.instagram && (
              <a href={contact.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"
                 class="flex h-10 w-10 items-center justify-center rounded-full ring-1 ring-white/20 transition hover:bg-white/10">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
              </a>
            )}
            {contact.social.facebook && (
              <a href={contact.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"
                 class="flex h-10 w-10 items-center justify-center rounded-full ring-1 ring-white/20 transition hover:bg-white/10">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6c-.29-.04-1.27-.13-2.4-.13-2.38 0-4 1.45-4 4.11v2.32H7.6V14h2.7v8h3.2Z"/></svg>
              </a>
            )}
            {contact.social.linkedin && (
              <a href={contact.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"
                 class="flex h-10 w-10 items-center justify-center rounded-full ring-1 ring-white/20 transition hover:bg-white/10">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.9V21h3.04V8.5ZM5.42 3a1.77 1.77 0 1 0 0 3.53 1.77 1.77 0 0 0 0-3.53ZM21 21h-3.03v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H10.6V8.5h2.9v1.71h.04a3.19 3.19 0 0 1 2.87-1.58c3.07 0 3.64 2.02 3.64 4.65V21Z"/></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-8">
      <div class="flex flex-col gap-4 text-[0.82rem] text-navy-300 md:flex-row md:items-center md:justify-between">
        <p>&copy; {year} {site.legalName}. All rights reserved.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/privacy/" class="transition hover:text-white">Privacy Policy</a>
          <a href="/accessibility/" class="transition hover:text-white">Accessibility</a>
          <a href="/careers/" class="transition hover:text-white">Careers</a>
        </div>
      </div>
      <p class="mt-5 max-w-4xl text-[0.75rem] leading-relaxed text-navy-400">
        The information on this website is for general educational purposes and is not medical advice,
        a diagnosis, or a treatment recommendation. Please do not submit medical or health information
        through our contact forms. If this is an emergency, call 911.
      </p>
    </div>
  </div>
</footer>
