---
import { contact, nav } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<div class="hidden bg-navy-900 text-navy-100 lg:block">
  <div class="container-page flex h-10 items-center justify-between text-[0.8rem]">
    <p class="flex items-center gap-2">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf-300 opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-leaf-300"></span>
      </span>
      Now accepting new clients across Florida &middot; Most insurance accepted
    </p>
    <div class="flex items-center gap-6">
      <a href={contact.emailHref} class="inline-flex items-center gap-2 transition hover:text-white">
        <Icon name="mail" class="h-3.5 w-3.5" />{contact.email}
      </a>
      <a href={contact.phoneHref} class="inline-flex items-center gap-2 font-semibold text-white transition hover:text-leaf-200">
        <Icon name="phone" class="h-3.5 w-3.5" />{contact.phone}
      </a>
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-white/80 backdrop-blur-xl transition-[border-color,box-shadow,background-color] duration-300"
>
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href="/" class="flex shrink-0 items-center" aria-label="Rise Behavior Therapy — home">
      <img src="/logo-h.svg" alt="Rise Behavior Therapy" class="h-9 w-auto sm:h-10 lg:h-11" width="180" height="44" />
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'relative whitespace-nowrap rounded-full px-3 py-2 text-[0.9rem] font-medium transition-colors duration-200 xl:px-4 xl:text-[0.925rem]',
            isActive(item.href)
              ? 'text-navy-800'
              : 'text-navy-700/80 hover:text-navy-800 hover:bg-navy-50',
          ]}
        >
          {item.label}
          {isActive(item.href) && (
            <span class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-leaf-600 xl:inset-x-4"></span>
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <a href={contact.phoneHref} class="btn-ghost hidden !px-5 !py-2.5 !text-sm md:inline-flex lg:hidden xl:inline-flex">
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden xl:inline">{contact.phone}</span>
        <span class="xl:hidden">Call</span>
      </a>
      <a href="/contact/" class="btn-primary hidden !px-5 !py-2.5 !text-sm sm:inline-flex lg:!px-6 lg:!py-3 lg:!text-[0.95rem]">
        Free Consultation
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-full text-navy-800 ring-1 ring-navy-200 transition hover:bg-navy-50 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path id="menu-open-icon" d="M4 7h16M4 12h16M4 17h16" />
          <path id="menu-close-icon" class="hidden" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white lg:hidden">
    <nav class="container-page flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-between rounded-2xl px-4 py-3.5 text-base font-medium text-navy-800 transition hover:bg-navy-50"
        >
          {item.label}
          <Icon name="arrow" class="h-4 w-4 text-navy-300" />
        </a>
      ))}
      <div class="mt-3 grid gap-2.5 border-t border-navy-100 pt-4 pb-2">
        <a href={contact.phoneHref} class="btn-ghost w-full">
          <Icon name="phone" class="h-4 w-4" />{contact.phone}
        </a>
        <a href="/contact/" class="btn-accent w-full">Request a Free Consultation</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });

  const header = document.getElementById('site-header');
  const onScroll = () => {
    const stuck = window.scrollY > 8;
    header?.classList.toggle('border-navy-100', stuck);
    header?.classList.toggle('shadow-[0_6px_28px_-18px_rgba(14,30,70,0.35)]', stuck);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
