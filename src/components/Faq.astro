---
import { faqs } from '../data/site';

interface Props {
  limit?: number;
  heading?: string;
}
const { limit, heading = 'Questions parents ask us first' } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<section class="container-page py-16 lg:py-24">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start" data-reveal>
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-4 text-3xl sm:text-4xl lg:text-[2.6rem] lg:leading-[1.12]">{heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        Straight answers, no jargon. If yours isn’t here, call us — we’d rather have the
        conversation than leave you guessing.
      </p>
      <a href="/contact/" class="btn-ghost mt-8">Ask us anything</a>
    </div>

    <div class="divide-y divide-navy-100 border-y border-navy-100">
      {items.map((f, i) => (
        <details class="group" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 50}ms`}>
          <summary
            class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold text-navy-800 transition-colors hover:text-leaf-700"
          >
            <span class="font-serif">{f.q}</span>
            <span
              class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full ring-1 ring-navy-200 transition-all duration-300 group-open:rotate-45 group-open:bg-navy-800 group-open:text-white group-open:ring-navy-800"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="max-w-2xl pb-7 text-[1.02rem] leading-relaxed text-ink-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })}
/>
