---
import { contact, faqs } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section id="faq" aria-labelledby="faq-heading">
  <div class="faq-layout">
    <div class="faq-intro">
      <p class="faq-eyebrow">06 — Frequently Asked Questions</p>
      <h2 id="faq-heading">A little clarity before your next step.</h2>
      <p>Starting something new comes with questions. Here are a few answers to help you get to know Rise and what to expect.</p>
      <a class="faq-contact" href="#contact">Ask us a question <span aria-hidden="true">↗</span></a>
      <a class="faq-phone" href={contact.phoneHref}>Or call {contact.phone}</a>
    </div>

    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq-item">
          <summary>
            <span>{q}</span>
            <svg class="faq-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M5 12h14" />
              <path class="faq-plus" d="M12 5v14" />
            </svg>
          </summary>
          <p class="faq-answer">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  section {
    background: #f3f0e9;
    border-bottom: 1px solid #e6e0d6;
    padding: 96px 32px;
  }

  .faq-layout {
    max-width: 1176px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px 80px;
    align-items: start;
  }

  .faq-eyebrow {
    margin: 0 0 22px;
    color: #1c7a45;
    font: 400 12.5px/1.7 'IBM Plex Mono', monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 24px;
    font: 300 clamp(31px, 3.7vw, 46px)/1.12 'Newsreader', serif;
    letter-spacing: -0.015em;
  }

  .faq-intro > p:not(.faq-eyebrow) {
    margin: 0 0 28px;
    color: #5a6472;
    font-size: 18px;
    line-height: 1.68;
  }

  .faq-contact {
    display: inline-flex;
    gap: 14px;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    font-size: 16.5px;
    font-weight: 500;
  }

  .faq-phone {
    display: block;
    width: fit-content;
    margin-top: 18px;
    color: #3a4859;
    font-size: 15.5px;
  }

  .faq-list {
    min-width: 0;
    border-top: 1px solid #0e2440;
  }

  .faq-item {
    border-bottom: 1px solid #d8d2c7;
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 0;
    color: #0e2440;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }
  summary:hover { color: #1c7a45; }
  summary:focus-visible {
    outline: 2px solid #1c7a45;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .faq-icon {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    margin-top: 2px;
    color: #1c7a45;
  }

  details[open] .faq-plus { display: none; }

  .faq-answer {
    margin: 0;
    padding: 0 32px 26px 0;
    color: #5a6472;
    font-size: 17px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (max-width: 800px) {
    .faq-layout { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 560px) {
    section { padding: 72px 20px; }
    .faq-answer { padding-right: 0; }
  }
</style>
