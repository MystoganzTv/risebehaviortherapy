---
import { contact } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Let’s take the first step together.',
  body = 'One short call is all it takes to find out whether Rise is the right fit for your family. We will verify your insurance benefits at no cost and walk you through exactly what happens next.',
} = Astro.props;
---

<section class="container-page py-16 lg:py-24">
  <div
    class="relative overflow-hidden rounded-[2.5rem] bg-navy-800 px-7 py-14 text-white sm:px-12 lg:px-16 lg:py-20"
    data-reveal
  >
    <div class="pointer-events-none absolute inset-0 grid-lines opacity-50 mix-blend-overlay"></div>
    <div class="pointer-events-none absolute -right-20 -top-28 h-96 w-96 rounded-full bg-leaf-400/20 blur-3xl"></div>
    <img
      src="/icon-white.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-10 right-4 hidden w-56 opacity-[0.07] lg:block"
    />

    <div class="relative max-w-2xl">
      <p class="eyebrow !text-leaf-300">Free consultation</p>
      <h2 class="mt-4 text-3xl !text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-navy-200">{body}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact/" class="btn-accent">
          Request a free consultation<Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href={contact.phoneHref} class="btn-onnavy">
          <Icon name="phone" class="h-4 w-4" />{contact.phone}
        </a>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm text-navy-200">
        <span class="inline-flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-leaf-300" />No cost, no obligation</span>
        <span class="inline-flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-leaf-300" />Free benefits verification</span>
        <span class="inline-flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-leaf-300" />Answers from a BCBA</span>
      </div>
    </div>
  </div>
</section>
